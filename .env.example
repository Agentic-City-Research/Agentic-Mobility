# Model-service settings for MorningExperiment and MorningReplay.
#
# IMPORTANT: the program does NOT auto-load a .env file. These variables must be
# exported in the shell (bash/zsh) or set as system/user environment variables
# (Windows) before launching. The file exists only as documentation of the keys.
#
#   bash / zsh :   set -a; source .env.example; set +a
#   Windows cmd:   for /f "usebackq tokens=1,* delims==" %a in (".env.example") do set %a=%b
#
# Set the API key, model name, and endpoint for your model service.
# The client speaks the OpenAI chat-completions protocol, so AGENTIC_BASE_URL +
# AGENTIC_MODEL can point at any compatible provider (DeepSeek, OpenAI, ...).

# Your API key (e.g. https://platform.deepseek.com). Never commit this.
AGENTIC_API_KEY=

# Model name (default shown).
AGENTIC_MODEL=deepseek-flash

# OpenAI-compatible endpoint (default shown).
AGENTIC_BASE_URL=https://api.deepseek.com

# auto: DeepSeek endpoint sends disabled; other endpoints omit vendor field.
# For a generic local/vLLM server use omit; enabled/disabled only where supported.
AGENTIC_THINKING=auto
# Optional supported parameters; blank means omitted, not assumed zero.
AGENTIC_TEMPERATURE=
AGENTIC_TOP_P=
AGENTIC_GENERATION_SEED=
AGENTIC_TOKEN_LIMIT_FIELD=max_tokens
AGENTIC_RESPONSE_FORMAT=omit
# Optional provider-specific JSON object, e.g. vLLM chat_template_kwargs.
AGENTIC_GENERATION_PARAMS={}
AGENTIC_REASON_MAX_CHARS=120

# Per-request full-response HTTP deadline in seconds (default 300).
AGENTIC_TIMEOUT_SECONDS=300
# Fail the run if no LLM decision completes for this many seconds (default 600).
# Applies to manager and traveler stages; not a total daily duration limit.
AGENTIC_LLM_STALL_SECONDS=600

# Traveler decision output limit (MorningExperiment default 1024).
# Traveler and manager memory tasks have separate CLI output limits.
AGENTIC_MAX_OUTPUT_TOKENS=1024

# Hard cap on total API requests before the experiment aborts (default 25000).
AGENTIC_MAX_REQUESTS=25000
