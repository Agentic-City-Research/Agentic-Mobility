<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE config SYSTEM "http://www.matsim.org/files/dtd/config_v2.dtd">
<!-- MATSim 2026 adaptation of the local public car-only .orig configuration.
     Full-day scoring/demand retained. Not a byte-identical historical replication.
     MorningExperiment reserves output/<date and parameters>, with numbered repeats. -->
<config>
  <module name="global">
    <param name="coordinateSystem" value="Atlantis" />
    <param name="randomSeed" value="4711" />
    <param name="numberOfThreads" value="4" />
  </module>
  <module name="controller">
    <param name="outputDirectory" value="output/${runName}" />
    <param name="firstIteration" value="0" />
    <param name="lastIteration" value="3000" />
    <param name="overwriteFiles" value="failIfDirectoryExists" />
    <param name="routingAlgorithmType" value="Dijkstra" />
    <param name="writeEventsInterval" value="50" />
    <param name="writePlansInterval" value="50" />
    <param name="writeSnapshotsInterval" value="0" />
    <param name="createGraphsInterval" value="50" />
  </module>
  <module name="network">
    <param name="inputNetworkFile" value="../Souix Falls 2014/Siouxfalls_network_Car.xml.gz" />
  </module>
  <module name="facilities">
    <param name="inputFacilitiesFile" value="../Souix Falls 2014/Siouxfalls_facilities.xml.gz" />
  </module>
  <module name="plans">
    <param name="inputPlansFile" value="../Souix Falls 2014/Siouxfalls_population_200pct.xml.gz" />
    <param name="activityDurationInterpretation" value="tryEndTimeThenDuration" />
  </module>
  <module name="routing">
    <param name="networkModes" value="car" />
    <!-- Explicit modern behavior: include facility-to-road access/egress walks in OD times. -->
    <param name="accessEgressType" value="accessEgressModeToLink" />
    <parameterset type="teleportedModeParameters">
      <param name="mode" value="walk" />
      <param name="teleportedModeSpeed" value="0.8333333333333333" />
      <param name="beelineDistanceFactor" value="1.3" />
    </parameterset>
  </module>
  <module name="qsim">
    <param name="startTime" value="00:00:00" />
    <param name="endTime" value="30:00:00" />
    <param name="flowCapacityFactor" value="0.1" />
    <param name="storageCapacityFactor" value="0.1" />
    <param name="numberOfThreads" value="4" />
    <param name="mainMode" value="car" />
    <param name="removeStuckVehicles" value="false" />
    <param name="insertingWaitingVehiclesBeforeDrivingVehicles" value="false" />
    <param name="stuckTime" value="3600.0" />
    <param name="vehiclesSource" value="defaultVehicle" />
  </module>
  <module name="timeAllocationMutator">
    <param name="mutationRange" value="3600.0" />
    <param name="mutationAffectsDuration" value="true" />
  </module>
  <module name="replanning">
    <param name="maxAgentPlanMemorySize" value="6" />
    <param name="fractionOfIterationsToDisableInnovation" value="Infinity" />
    <parameterset type="strategysettings">
      <param name="strategyName" value="ChangeExpBeta" />
      <param name="weight" value="0.7" />
    </parameterset>
    <parameterset type="strategysettings">
      <param name="strategyName" value="ReRoute" />
      <param name="weight" value="0.1" />
      <param name="disableAfterIteration" value="2900" />
    </parameterset>
    <parameterset type="strategysettings">
      <param name="strategyName" value="TimeAllocationMutator" />
      <param name="weight" value="0.1" />
      <param name="disableAfterIteration" value="2900" />
    </parameterset>
  </module>
  <module name="scoring">
    <param name="brainExpBeta" value="1.0" />
    <param name="learningRate" value="1.0" />
    <parameterset type="scoringParameters">
      <param name="performing" value="0.96" />
      <param name="marginalUtilityOfMoney" value="0.062" />
      <param name="lateArrival" value="-2.88" />
      <param name="earlyDeparture" value="0.0" />
      <param name="waiting" value="0.0" />
      <param name="waitingPt" value="-0.18" />
      <param name="utilityOfLineSwitch" value="0.0" />
      <parameterset type="activityParams">
        <param name="activityType" value="home" />
        <param name="typicalDuration" value="13:00:00" />
        <param name="minimalDuration" value="01:00:00" />
        <param name="scoringThisActivityAtAll" value="true" />
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="work" />
        <param name="typicalDuration" value="09:00:00" />
        <param name="minimalDuration" value="08:00:00" />
        <param name="openingTime" value="08:00:00" />
        <param name="latestStartTime" value="09:00:00" />
        <param name="earliestEndTime" value="17:00:00" />
        <param name="closingTime" value="18:00:00" />
        <param name="scoringThisActivityAtAll" value="true" />
      </parameterset>
      <parameterset type="activityParams">
        <param name="activityType" value="secondary" />
        <param name="typicalDuration" value="01:00:00" />
        <param name="minimalDuration" value="00:30:00" />
        <param name="openingTime" value="08:00:00" />
        <param name="closingTime" value="20:00:00" />
        <param name="scoringThisActivityAtAll" value="true" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="car" />
        <param name="constant" value="-0.562" />
        <param name="marginalUtilityOfTraveling_util_hr" value="0.0" />
        <param name="marginalUtilityOfDistance_util_m" value="0.0" />
        <param name="monetaryDistanceRate" value="-0.0004" />
      </parameterset>
      <parameterset type="modeParams">
        <param name="mode" value="walk" />
        <param name="marginalUtilityOfTraveling_util_hr" value="-1.14" />
      </parameterset>
    </parameterset>
  </module>
</config>
